# ============================================================
# 丑团 · 生产镜像（纯静态站，单阶段 nginx）
# 构建：DOCKER_BUILDKIT=1 docker buildx build --platform linux/amd64 \
#         -f Dockerfile.prod -t choutuan-web:latest --load .
# ============================================================
FROM nginx:1.27-alpine

# 站点文件（纯静态，无构建步骤）
COPY index.html /usr/share/nginx/html/index.html
COPY favicon.ico /usr/share/nginx/html/favicon.ico
COPY site.webmanifest /usr/share/nginx/html/site.webmanifest
COPY css /usr/share/nginx/html/css
COPY js /usr/share/nginx/html/js
COPY img /usr/share/nginx/html/img

# 容器内 nginx 配置（gzip / 分层缓存 / 健康检查端点）
COPY deploy/nginx-container.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
