# ============================================================
# 丑团 · 生产镜像（FastAPI 后台 + 同源托管前端静态站）
# 构建：DOCKER_BUILDKIT=1 docker buildx build --platform linux/amd64 \
#         -f Dockerfile.prod -t choutuan-api:latest --load .
# 运行：uvicorn 监听容器内 8800（compose 映射宿主机 9000）
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# 后端依赖
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# 后端代码
COPY backend/app.py /app/backend/app.py

# 前端静态站（同源托管）
COPY index.html admin.html favicon.ico site.webmanifest /app/site/
COPY css /app/site/css
COPY js /app/site/js
COPY img /app/site/img

ENV SITE_DIR=/app/site \
    DB_DIR=/app/db

EXPOSE 8800

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8800/health',timeout=2)" || exit 1

CMD ["python", "-m", "uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8800"]
